{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fitness_state",
  "type": "object",
  "properties": {
    "body": {
      "type": "object",
      "properties": {
        "bmi": {
          "type": [
            "number",
            "null"
          ]
        },
        "weight_trend_7d": {
          "type": [
            "number",
            "null"
          ]
        },
        "weight_trend_30d": {
          "type": [
            "number",
            "null"
          ]
        },
        "estimated_body_fat": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "bmi",
        "weight_trend_7d",
        "weight_trend_30d",
        "estimated_body_fat"
      ],
      "additionalProperties": false
    },
    "activity": {
      "type": "object",
      "properties": {
        "activity_level": {
          "type": "string"
        },
        "weekly_training_load": {
          "type": [
            "number",
            "null"
          ]
        },
        "step_average_7d": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "activity_level",
        "weekly_training_load",
        "step_average_7d"
      ],
      "additionalProperties": false
    },
    "fitness": {
      "type": "object",
      "properties": {
        "cardio_level": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "strength_level": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "mobility_level": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "cardio_level",
        "strength_level",
        "mobility_level"
      ],
      "additionalProperties": false
    },
    "recovery": {
      "type": "object",
      "properties": {
        "fatigue": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "sleep_quality": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "soreness": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        }
      },
      "required": [
        "fatigue",
        "sleep_quality",
        "soreness"
      ],
      "additionalProperties": false
    },
    "adherence": {
      "type": "object",
      "properties": {
        "completion_rate_7d": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "completion_rate_14d": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "completion_rate_7d",
        "completion_rate_14d"
      ],
      "additionalProperties": false
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "phase": {
      "enum": [
        "INIT",
        "ADAPTATION",
        "PROGRESS",
        "PLATEAU",
        "DELOAD"
      ]
    },
    "phase_since": {
      "type": "string",
      "format": "date"
    },
    "last_adjusted": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "baseline_minutes": {
      "type": "number",
      "minimum": 0,
      "maximum": 180
    },
    "last_evaluated": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "body",
    "activity",
    "fitness",
    "recovery",
    "adherence",
    "confidence",
    "phase"
  ],
  "additionalProperties": false
}
